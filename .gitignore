venv/
.env
.env.*
!.env.example
credentials*.json
secrets*.json
secrets*.toml
*.pem
*.key

# Keep the data layout, never the competition data.
data/*
!data/.gitkeep
!data/README.md
!data/source/
!data/raw/
!data/interim/
!data/processed/

data/source/*
!data/source/.gitkeep

data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

submissions/*
!submissions/.gitkeep

# Rebuildable third-party runtimes, model weights, and experiment outputs.
vendor/
assets/*
!assets/README.md
experiments/runs/*
!experiments/runs/.gitkeep

# Never checkpoint generated model/data payloads outside their expected folders.
*.joblib
*.safetensors
*.parquet
*.npy
*.npz
*.zip

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
